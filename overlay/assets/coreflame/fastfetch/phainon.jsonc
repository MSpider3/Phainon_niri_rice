// Phainon · The Deliverer — a light, open record: lapis and sun-gold on paper.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "$HOME/.config/coreflame/fastfetch-logo.png",
    "width": 28,
    "height": 20,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "disableLinewrap": true,
    "separator": "  ",
    "color": { "keys": "38;2;51;71;134", "title": "38;2;51;71;134", "separator": "38;2;168;122;34", "output": "38;2;30;39;82" },
    "key": { "width": 14 },
    "percent": {
      "type": ["bar", "num"],
      "color": { "green": "38;2;51;71;134", "yellow": "38;2;168;122;34", "red": "38;2;179;49;43" }
    },
    "bar": { "width": 14, "char": { "elapsed": "━", "total": "─" }, "border": null, "color": { "elapsed": "38;2;51;71;134", "total": "38;2;200;192;170" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#38;2;168;122;34}✦ {#1;38;2;51;71;134}P H A I N O N{#}{#38;2;168;122;34}  ·  The Deliverer" },
    { "type": "command", "key": " ", "text": "printf 'Cycle %s · a true dawn awaits.' \"$(cat ~/.config/coreflame/cycle 2>/dev/null || echo 33,550,336)\"", "format": "{#3;38;2;110;118;150}{result}" },
    { "type": "custom", "format": "{#38;2;200;192;170}────────────── {#38;2;168;122;34}☀{#38;2;200;192;170} ──────────────" },
    { "type": "title", "key": "☀ Bearer", "format": "{user-name} at {host-name}" },
    { "type": "os", "key": "☀ Realm", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "☀ Core", "format": "{release}" },
    { "type": "uptime", "key": "☀ Dawn" },
    { "type": "wm", "key": "☀ Temple", "format": "{pretty-name}" },
    { "type": "shell", "key": "☀ Voice", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "☀ Window", "format": "{pretty-name}" },
    { "type": "custom", "format": "{#38;2;200;192;170}────────────── {#38;2;168;122;34}☀{#38;2;200;192;170} ──────────────" },
    { "type": "cpu", "key": "◇ Heart", "format": "{name}", "temp": false },
    { "type": "cpuusage", "key": "◇ Flame", "format": "{avg-bar} {avg}" },
    { "type": "memory", "key": "◇ Memory", "format": "{percentage-bar} {used} / {total}" },
    { "type": "disk", "key": "◇ Archive", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
    { "type": "battery", "key": "◇ Coreflame", "format": "{capacity-bar} {capacity} · {status}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
