// Khaslana · Bearer of Chaos — a recurrence notice: bracketed fields, molten gold, an ember-red scar.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "$HOME/.config/coreflame/fastfetch-logo.png",
    "width": 33,
    "height": 20,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "disableLinewrap": true,
    "separator": " ▸ ",
    "color": { "keys": "1;38;2;212;177;74", "title": "38;2;212;177;74", "separator": "38;2;229;84;76", "output": "38;2;241;233;201" },
    "key": { "width": 16 },
    "percent": {
      "type": ["bar", "num"],
      "color": { "green": "38;2;212;177;74", "yellow": "38;2;255;154;61", "red": "38;2;229;84;76" }
    },
    "bar": { "width": 14, "char": { "elapsed": "▰", "total": "▱" }, "border": { "left": "[", "right": "]" }, "color": { "elapsed": "38;2;255;154;61", "total": "38;2;70;60;40" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#38;2;229;84;76}▚▞ {#1;38;2;212;177;74}[ RECURRENCE NOTICE ]{#} {#38;2;229;84;76}▞▚" },
    { "type": "custom", "format": "{#1;38;2;241;233;201}KHASLANA{#}{#38;2;212;177;74} · BEARER OF CHAOS" },
    { "type": "custom", "format": "{#38;2;212;177;74}━━━━━━━━━━╸ {#38;2;229;84;76}╳{#38;2;212;177;74} ╺━━━━━━━━━━━━━━━━━━━━━━" },
    { "type": "title", "key": "[ BEARER ]", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "[ WORLD ]", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "[ CORE ]", "format": "{release}" },
    { "type": "uptime", "key": "[ BURNING ]" },
    { "type": "wm", "key": "[ FIELD ]", "format": "{pretty-name}" },
    { "type": "shell", "key": "[ COMMAND ]", "format": "{pretty-name} {version}" },
    { "type": "custom", "format": "{#38;2;212;177;74}━━━━━━━━━━━━━━━━━━━━━╸ {#38;2;229;84;76}╳{#38;2;212;177;74} ╺━━━━━━━━━━━" },
    { "type": "cpu", "key": "[ HEART ]", "format": "{name}", "temp": false },
    { "type": "cpuusage", "key": "[ LOAD ]", "format": "{avg-bar} {avg}" },
    { "type": "memory", "key": "[ MEMORY ]", "format": "{percentage-bar} {used} / {total}" },
    { "type": "disk", "key": "[ VAULT ]", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
    { "type": "battery", "key": "[ COREFLAME ]", "format": "{capacity-bar} {capacity} · {status}" },
    { "type": "command", "key": "[ CYCLE ]", "text": "cat ~/.config/coreflame/cycle 2>/dev/null || echo 33,550,336", "format": "{#38;2;229;84;76}{result}{#38;2;212;177;74} · THE WOUND BURNS" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
