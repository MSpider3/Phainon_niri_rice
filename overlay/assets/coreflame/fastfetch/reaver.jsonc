// The Flame Reaver — a log of the cycle: lowercase, quiet bronze, one violet line.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "$HOME/.config/coreflame/fastfetch-logo.png",
    "width": 30,
    "height": 20,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "disableLinewrap": true,
    "separator": "  ",
    "color": { "keys": "38;2;120;114;100", "title": "38;2;185;175;147", "separator": "38;2;80;80;80", "output": "38;2;199;201;220" },
    "key": { "width": 13 },
    "percent": {
      "type": ["bar", "num"],
      "color": { "green": "38;2;185;175;147", "yellow": "38;2;185;175;147", "red": "38;2;122;106;168" }
    },
    "bar": { "width": 12, "char": { "elapsed": "|", "total": "·" }, "border": null, "color": { "elapsed": "38;2;185;175;147", "total": "38;2;70;70;70" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#38;2;122;106;168}// {#38;2;185;175;147}the flame reaver · of the deepest dark" },
    { "type": "custom", "format": "{#38;2;90;90;90}// signal caught. reading what is left." },
    "break",
    { "type": "title", "key": "// vessel", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "// ruins", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "// core", "format": "{release}" },
    { "type": "uptime", "key": "// awake" },
    { "type": "wm", "key": "// field", "format": "{pretty-name}" },
    { "type": "cpuusage", "key": "// strain", "format": "{avg-bar} {avg}" },
    { "type": "memory", "key": "// memory", "format": "{percentage-bar} {used} / {total}" },
    { "type": "disk", "key": "// remains", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
    { "type": "battery", "key": "// ember", "format": "{capacity-bar} {capacity} · {status}" },
    "break",
    { "type": "command", "key": "// cycle", "text": "printf '%s · all is futility.' \"$(cat ~/.config/coreflame/cycle 2>/dev/null || echo 33,550,336)\"", "format": "{#38;2;122;106;168}{result}" }
  ]
}
