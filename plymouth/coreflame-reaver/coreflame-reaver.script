// Coreflame · Flame Reaver: the form's figure on its own colour, a thin line that fills as the
// machine boots, and the cycle's words underneath. Static apart from the progress line.
Window.SetBackgroundTopColor(0.055, 0.059, 0.059);
Window.SetBackgroundBottomColor(0.055, 0.059, 0.059);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

figure.image = Image("figure.png");
scale = (screen_h * 0.5) / figure.image.GetHeight();
figure.image = figure.image.Scale(figure.image.GetWidth() * scale, figure.image.GetHeight() * scale);
figure.sprite = Sprite(figure.image);
figure.sprite.SetX(screen_w / 2 - figure.image.GetWidth() / 2);
figure.sprite.SetY(screen_h * 0.42 - figure.image.GetHeight() / 2);

words.image = Image.Text("climb, fall, climb again", 0.478, 0.416, 0.659, 0.8, "Sans 12");
words.sprite = Sprite(words.image);
words.sprite.SetX(screen_w / 2 - words.image.GetWidth() / 2);
words.sprite.SetY(screen_h * 0.78);

bar_w = screen_w * 0.24;
line.image = Image("line.png");
line.sprite = Sprite();
line.sprite.SetY(screen_h * 0.74);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_w * progress);
    if (w < 1) w = 1;
    line.sprite.SetImage(line.image.Scale(w, 2));
    line.sprite.SetX(screen_w / 2 - bar_w / 2);
}
Plymouth.SetBootProgressFunction(progress_callback);

// Disk password, for encrypted systems
fun display_password_callback(prompt, bullets) {
    text = prompt + "  ";
    for (i = 0; i < bullets; i++) text += "•";
    prompt_image = Image.Text(text, 0.478, 0.416, 0.659, 1, "Sans 12");
    prompt_sprite = Sprite(prompt_image);
    prompt_sprite.SetX(screen_w / 2 - prompt_image.GetWidth() / 2);
    prompt_sprite.SetY(screen_h * 0.84);
    global.prompt_sprite = prompt_sprite;
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    global.prompt_sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
